msgstr "“9月”"

#: src/ch03-02-data-types.md:350
msgid "\"October\""
msgstr "\"10月\""

#: src/ch03-02-data-types.md:350
msgid "\"November\""
msgstr "\"11月\""

#: src/ch03-02-data-types.md:350
