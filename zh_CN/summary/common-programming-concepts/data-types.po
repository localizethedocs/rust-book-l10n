msgstr "“4月”"

#: src/ch03-02-data-types.md:349
msgid "\"May\""
msgstr "\"5月\""

#: src/ch03-02-data-types.md:349
msgid "\"June\""
msgstr "\"6月\""

#: src/ch03-02-data-types.md:349
msgid "\"July\""
msgstr "“7月”"

#: src/ch03-02-data-types.md:350
msgid "\"August\""
msgstr "“8月”"

#: src/ch03-02-data-types.md:350
