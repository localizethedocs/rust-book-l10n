msgid "\"January\""
msgstr "“1月”"

#: src/ch03-02-data-types.md:349
msgid "\"February\""
msgstr "\"2月\""

#: src/ch03-02-data-types.md:349
msgid "\"March\""
msgstr "“3月”"

#: src/ch03-02-data-types.md:349
