msgid "// Change our mind about what bread we'd like.\n"
msgstr "// 改变我们关于面包所喜欢的想法。\n"

#: src/ch07-03-paths-for-referring-to-an-item-in-the-module-tree.md:374
msgid "\"Wheat\""
msgstr "“Wheat”"

