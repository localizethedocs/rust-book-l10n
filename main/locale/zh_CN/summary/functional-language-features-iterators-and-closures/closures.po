msgid ""
"<a id=\"closures-anonymous-functions-that-can-capture-their-environment\"></"
"a> <a id=\"closures-anonymous-functions-that-capture-their-environment\"></a>"
msgstr ""
"<a id=\"closures-anonymous-functions-that-can-capture-their-environment\"></"
