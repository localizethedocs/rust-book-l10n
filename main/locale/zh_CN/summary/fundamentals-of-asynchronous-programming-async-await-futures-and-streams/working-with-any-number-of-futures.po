msgstr "\"a\""

#: src/ch17-03-more-futures.md:69 src/ch17-03-more-futures.md:150
#: src/ch17-03-more-futures.md:227
msgid "\"'a' finished.\""
msgstr "\"'a' finished.\"。"

#: src/ch17-03-more-futures.md:73 src/ch17-03-more-futures.md:154
#: src/ch17-03-more-futures.md:231
msgid "\"'b' started.\""
msgstr "\"'b' started.\"。"

